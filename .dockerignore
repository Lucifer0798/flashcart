# Keep the build context small — the image builds from source inside the container, so nothing
# already compiled on the host should be shipped into it (and a host-built target/ would shadow
# the container's own build output).
**/target/
.git/
.github/
.idea/
# Only the wrapper: .mvn/maven.config is how the image build gets its download retries (see the Dockerfile).
.mvn/wrapper/
docs/
*.md
mvnw
mvnw.cmd
