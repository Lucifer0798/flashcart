<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.flashcart</groupId>
		<artifactId>flashcart-parent</artifactId>
		<version>0.1.0-SNAPSHOT</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>

	<artifactId>flashcart-gateway</artifactId>
	<name>flashcart-gateway</name>
	<description>The single front door: routing, correlation IDs, and the edge concerns</description>

	<dependencies>
		<!-- Declared explicitly because flashcart-common marks it optional: this service verifies
		     access tokens, so it pays for the library that does it. -->
		<dependency>
			<groupId>com.nimbusds</groupId>
			<artifactId>nimbus-jose-jwt</artifactId>
		</dependency>
		<dependency>
			<groupId>com.flashcart</groupId>
			<artifactId>flashcart-common</artifactId>
		</dependency>
		<!--
		  Spring Cloud Gateway 5.x split the old spring-cloud-starter-gateway into explicit
		  server-webflux and server-webmvc flavours. WebFlux is the right one here: the gateway does
		  nothing but proxy, so a non-blocking stack holds far more concurrent flash-sale
		  connections per thread than one servlet-per-request would.
		-->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Turns the /actuator/prometheus endpoint from a 404 into a scrape target. Every service
		     has listed prometheus in its actuator exposure since Phase 1; this is the registry that
		     finally makes that line true. -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Tracing. Phase 9 deferred this deliberately: correlation ids already stitched a checkout
		     together in the logs, and a backend was not worth its memory until there were injected
		     failures worth following across the bus. Phase 11 is that. -->
		<!-- OpenTelemetry, not Brave. Boot 4 ships spring-boot-micrometer-tracing-opentelemetry and
		     has no Brave equivalent, so a brave bridge resolves, packages, and then silently traces
		     nothing, because no autoconfiguration ever runs. The Boot module is a separate artifact from
		     the bridge for the same reason flyway and the rest-client are: Boot 4 split its
		     autoconfigurations out, and depending on the library alone wires up nothing. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
		</dependency>
		<!-- The bridge implements Micrometer's Tracer over OpenTelemetry. The Boot module above does
		     not pull it, and without it Boot quietly installs NoopTracerAutoConfiguration: the SDK,
		     the exporter and the autoconfiguration are all present and every span is discarded. -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-otel</artifactId>
		</dependency>
		<dependency>
			<groupId>io.opentelemetry</groupId>
			<artifactId>opentelemetry-exporter-zipkin</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Supplies ZipkinAutoConfiguration and the endpoint property. The exporter above is only the
		     encoder; without this module nothing ever reads management.zipkin.tracing.endpoint and
		     the spans are built and dropped. Third separate artifact needed to make one feature work,
		     which is the shape of Boot 4's autoconfiguration split. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-zipkin</artifactId>
			<scope>runtime</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
