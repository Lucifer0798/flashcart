<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.flashcart</groupId>
		<artifactId>flashcart-parent</artifactId>
		<version>0.1.0-SNAPSHOT</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>

	<artifactId>flashcart-catalog</artifactId>
	<name>flashcart-catalog</name>
	<description>Products, categories and flash-sale definitions</description>

	<dependencies>
		<dependency>
			<groupId>com.flashcart</groupId>
			<artifactId>flashcart-common</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Turns the /actuator/prometheus endpoint from a 404 into a scrape target. Every service
		     has listed prometheus in its actuator exposure since Phase 1; this is the registry that
		     finally makes that line true. -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
		</dependency>
		<!--
		  The starter, not a bare flyway-core. Boot 4 split its auto-configurations out of
		  spring-boot-autoconfigure into per-technology modules, so flyway-core on its own gives the
		  library with nothing wiring it to the datasource — migrations silently never run and
		  Hibernate then fails validation against an empty schema.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
		  Testcontainers rather than H2. The schema uses Postgres-specific types and constraints
		  (citext-free case-insensitive uniqueness via a functional index, numeric(12,2), timestamptz),
		  and an in-memory dialect that silently accepts different semantics is worse than no test.
		  Note the artifact ids: Testcontainers 2.x prefixes its modules with `testcontainers-`.
		-->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  Boot 4 moved TestRestTemplate out of spring-boot-test into its own spring-boot-resttestclient
		  module (and out of the org.springframework.boot.test.web.client package), so starter-test no
		  longer brings it. Declared explicitly rather than rewriting the suite against RestTestClient.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-resttestclient</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  ...and resttestclient does not pull this itself, though its auto-configuration takes a
		  RestTemplateBuilder parameter. Without it the bean method's signature will not resolve and
		  the whole test context fails to load with a misleading @ConditionalOnMissingBean error.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-restclient</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
